{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)"
    ]
  }
}
